# Postgres — memory + run log. Local peer auth needs no password.
DATABASE_URL=postgres://localhost:5432/agentdb

API_HOST=127.0.0.1
API_PORT=8095

# LLM: leave GROQ_API_KEY empty to run on the deterministic mock LLM (keyless).
# Set it (free at console.groq.com) to use a real tool-calling model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Agent guardrails
MAX_ITERATIONS=12
CIRCUIT_BREAKER_THRESHOLD=3
TOOL_TIMEOUT_SECONDS=10
